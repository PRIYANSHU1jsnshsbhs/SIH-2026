FROM maven:3.9.11-eclipse-temurin-21 AS build

WORKDIR /build

# Cache dependencies separately from application sources.
COPY backend/backend/pom.xml ./pom.xml
RUN mvn --batch-mode dependency:go-offline

COPY backend/backend/src ./src
RUN mvn --batch-mode clean package -DskipTests

FROM eclipse-temurin:21-jre

WORKDIR /app

RUN useradd --system --uid 10001 --create-home lapus

COPY --from=build /build/target/vaspattribution-0.0.1-SNAPSHOT.jar /app/lapus-backend.jar
COPY crypto_mock_dataset.json /app/crypto_mock_dataset.json

RUN chown -R lapus:lapus /app

USER lapus

EXPOSE 10000

# Render supplies a standard PostgreSQL URL. Spring JDBC requires the same URL
# with the "jdbc:" prefix, so convert it at container startup without exposing
# credentials in the image or source repository.
CMD ["sh", "-c", "export SPRING_DATASOURCE_URL=\"jdbc:${RENDER_DATABASE_URL}\"; export SPRING_DATASOURCE_USERNAME=\"${RENDER_DATABASE_USER}\"; export SPRING_DATASOURCE_PASSWORD=\"${RENDER_DATABASE_PASSWORD}\"; exec java ${JAVA_OPTS} -Dserver.port=${PORT:-10000} -jar /app/lapus-backend.jar"]
