FROM maven:3.9.11-eclipse-temurin-21 AS build

WORKDIR /build

# Cache dependencies separately from application sources.
COPY backend/backend/pom.xml ./pom.xml
RUN mvn --batch-mode dependency:go-offline

COPY backend/backend/src ./src
RUN mvn --batch-mode clean package -DskipTests

FROM eclipse-temurin:21-jre

WORKDIR /app

RUN useradd --system --uid 10001 --create-home lapus

COPY --from=build /build/target/vaspattribution-0.0.1-SNAPSHOT.jar /app/lapus-backend.jar
COPY crypto_mock_dataset.json /app/crypto_mock_dataset.json
COPY deploy/render-entrypoint.sh /app/render-entrypoint.sh

RUN chmod +x /app/render-entrypoint.sh && chown -R lapus:lapus /app

USER lapus

EXPOSE 10000

ENTRYPOINT ["/app/render-entrypoint.sh"]
